{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "portfolio": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/portfolio",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              "src/manifest.webmanifest"
            ],
            "styles": [
              "src/styles.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "staging": {
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public"
                },
                {
                  "glob": "**/*",
                  "input": "public-drafts"
                },
                "src/manifest.webmanifest"
              ],
              "fileReplacements": [
                {
                  "replace": "src/app/features/portfolio/case-studies/data/drafts.ts",
                  "with": "src/app/features/portfolio/case-studies/data/drafts.development.ts"
                },
                {
                  "replace": "src/app/features/writing/drafts.ts",
                  "with": "src/app/features/writing/drafts.development.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public"
                },
                {
                  "glob": "**/*",
                  "input": "public-drafts"
                },
                "src/manifest.webmanifest"
              ],
              "fileReplacements": [
                {
                  "replace": "src/app/features/portfolio/case-studies/data/drafts.ts",
                  "with": "src/app/features/portfolio/case-studies/data/drafts.development.ts"
                },
                {
                  "replace": "src/app/features/writing/drafts.ts",
                  "with": "src/app/features/writing/drafts.development.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "portfolio:build:production"
            },
            "development": {
              "buildTarget": "portfolio:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "fileReplacements": [
              {
                "replace": "src/app/features/portfolio/case-studies/data/drafts.ts",
                "with": "src/app/features/portfolio/case-studies/data/drafts.development.ts"
              },
              {
                "replace": "src/app/features/writing/drafts.ts",
                "with": "src/app/features/writing/drafts.development.ts"
              }
            ],
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*",
                "input": "public-drafts"
              },
              "src/manifest.webmanifest"
            ],
            "styles": [
              "src/styles.css"
            ],
            "scripts": []
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
